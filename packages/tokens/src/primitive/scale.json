{
  "space": {
    "0": { "$value": "0rem", "$type": "dimension" },
    "1": { "$value": "0.25rem", "$type": "dimension" },
    "2": { "$value": "0.5rem", "$type": "dimension" },
    "3": { "$value": "0.75rem", "$type": "dimension" },
    "4": { "$value": "1rem", "$type": "dimension" },
    "6": { "$value": "1.5rem", "$type": "dimension" },
    "8": { "$value": "2rem", "$type": "dimension" },
    "12": { "$value": "3rem", "$type": "dimension" },
    "16": { "$value": "4rem", "$type": "dimension" },
    "20": { "$value": "5rem", "$type": "dimension" },
    "24": { "$value": "6rem", "$type": "dimension" }
  },
  "radius": {
    "chamfer": { "$value": "2px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "type": {
    "family": {
      "display": {
        "$value": "'Archivo Variable', sans-serif",
        "$type": "fontFamily"
      },
      "body": {
        "$value": "'IBM Plex Sans', sans-serif",
        "$type": "fontFamily"
      },
      "data": { "$value": "'IBM Plex Mono', monospace", "$type": "fontFamily" }
    },
    "width": {
      "display": { "$value": "125", "$type": "number" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "number" },
      "medium": { "$value": "500", "$type": "number" },
      "bold": { "$value": "700", "$type": "number" }
    },
    "ui": {
      "size-xs": { "$value": "0.75rem", "$type": "dimension" },
      "size-sm": { "$value": "0.875rem", "$type": "dimension" },
      "size-md": { "$value": "1rem", "$type": "dimension" },
      "size-lg": { "$value": "1.25rem", "$type": "dimension" },
      "size-xl": { "$value": "1.5rem", "$type": "dimension" },
      "size-2xl": { "$value": "2rem", "$type": "dimension" },
      "size-3xl": { "$value": "3rem", "$type": "dimension" },
      "leading": { "$value": "1.35", "$type": "number" }
    },
    "prose": {
      "size-sm": { "$value": "0.9375rem", "$type": "dimension" },
      "size-md": { "$value": "1.0625rem", "$type": "dimension" },
      "size-lg": { "$value": "1.375rem", "$type": "dimension" },
      "size-2xl": { "$value": "1.875rem", "$type": "dimension" },
      "leading": { "$value": "1.65", "$type": "number" },
      "measure": { "$value": "68ch", "$type": "dimension" }
    }
  },
  "shadow": {
    "overlay": {
      "$value": "0 8px 24px -4px rgb(28 26 23 / 0.18)",
      "$type": "shadow"
    }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "base": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "320ms", "$type": "duration" }
    },
    "easing": {
      "standard": {
        "$value": "cubic-bezier(0.2, 0, 0, 1)",
        "$type": "cubicBezier"
      },
      "enter": { "$value": "cubic-bezier(0, 0, 0, 1)", "$type": "cubicBezier" },
      "exit": { "$value": "cubic-bezier(0.3, 0, 1, 1)", "$type": "cubicBezier" }
    }
  }
}
