{
  "name": "@beff/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "//": "One subpath export per component, and deliberately NO root barrel. A root barrel re-exporting forty components means importing one button drags the whole library into the bundle; per-unit barrels cost nothing. Source is exported directly and transpiled by the consumer (`transpilePackages` in next.config), so there is no build step to keep in sync and no dist to go stale.",
  "exports": {
    "./alert": "./src/components/Alert/index.ts",
    "./base.css": "./src/styles/base.css",
    "./button": "./src/components/Button/index.ts",
    "./chart": "./src/lib/chart/index.ts",
    "./chart-figure": "./src/components/ChartFigure/index.ts",
    "./cookie-banner": "./src/components/CookieBanner/index.ts",
    "./country-select": "./src/components/CountrySelect/index.ts",
    "./cx": "./src/lib/cx/index.ts",
    "./data-state": "./src/components/DataState/index.ts",
    "./data-table": "./src/components/DataTable/index.ts",
    "./display": "./src/components/Display/index.ts",
    "./echart": "./src/components/EChart/index.ts",
    "./eyebrow": "./src/components/Eyebrow/index.ts",
    "./field": "./src/components/Field/index.ts",
    "./fonts.css": "./src/styles/fonts.css",
    "./info-hint": "./src/components/InfoHint/index.ts",
    "./lede": "./src/components/Lede/index.ts",
    "./media": "./src/lib/media/index.ts",
    "./metric": "./src/components/Metric/index.ts",
    "./reading": "./src/components/Reading/index.ts",
    "./spec-band": "./src/components/SpecBand/index.ts",
    "./text-field": "./src/components/TextField/index.ts",
    "./theme-script": "./src/components/ThemeScript/index.ts",
    "./theme-toggle": "./src/components/ThemeToggle/index.ts",
    "./video-player": "./src/components/VideoPlayer/index.ts",
    "./visually-hidden": "./src/components/VisuallyHidden/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:storybook": "vitest run src/stories.test.tsx",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build",
    "clean": "rm -rf node_modules .turbo storybook-static"
  },
  "//peerDependencies": "`echarts` is a peer, not a dependency. `echarts/core` keeps its registry of chart types in module state, so the app's `use()` calls and this package's must reach the *same* module instance - two copies at different versions would register into one registry and draw from the other, and the symptom is an empty chart with no error. A peer makes the consumer own the single copy.",
  "peerDependencies": {
    "echarts": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@beff/config": "workspace:*",
    "@beff/tokens": "workspace:*",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "echarts": "^6.1.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "downshift": "^9.4.0",
    "flag-icons": "^7.6.0"
  }
}
