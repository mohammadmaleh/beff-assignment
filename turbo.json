{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!**/*.stories.*"],
      "env": ["API_ORIGIN", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_SITE_URL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "storybook-static/**"]
    },
    "dev": {
      // `^build` so `@beff/tokens/dist` exists before anything imports it.
      // `globals.css` does `@import '@beff/tokens/css'`, which resolves to a
      // *generated* file - without this, a fresh clone's first `pnpm dev` fails
      // on a missing stylesheet, and the error names the CSS rather than the
      // build that never ran. Cheap: turbo caches `build`, so it is a cache hit
      // on every run where the tokens have not changed.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:storybook": {
      // `^build`, never `build`. `packages/ui` deliberately has no build script
      // - it ships source - and turbo resolves a `dependsOn` across the whole
      // workspace graph, so a task depending on a build that cannot run breaks
      // the root commands repo-wide. This one needs `@beff/tokens` built, which
      // is exactly what the caret says.
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:a11y": {
      "dependsOn": ["^build"],
      "outputs": ["playwright-report/**"]
    },
    "clean": {
      "cache": false
    },
    "check:drift": {
      "cache": false
    }
  }
}
