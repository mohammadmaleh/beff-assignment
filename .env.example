# Copy to .env and adjust. .env is gitignored and must never be committed.
# Every value here is a development default and is unsafe in production.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=beff
POSTGRES_PASSWORD=beff_dev_password
POSTGRES_DB=beff
POSTGRES_PORT=5432

# ── Ports ───────────────────────────────────────────────────────────────────
API_PORT=8000
WEB_PORT=3000

# ── Secrets ─────────────────────────────────────────────────────────────────
# Generate real values with:  openssl rand -hex 32
JWT_SECRET=dev_only_do_not_use_in_production

# Salt for hashing IP addresses. IPs are personal data under GDPR, so they are
# never stored raw. Rotating this salt breaks the ability to correlate existing
# consent records - treat it as durable.
IP_HASH_SALT=dev_only_salt

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Email ────────────────────────────────────────────────────────────────
# Where the confirmation link points. Read by the API, not the worker: the
# link is baked into the message body at enqueue time.
APP_BASE_URL=http://localhost:3000

# Empty SMTP_HOST means messages are logged instead of sent. docker-compose
# overrides these to point at the bundled Mailpit, so the default local stack
# delivers into http://localhost:8025 and needs no mail account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Mutually exclusive. STARTTLS upgrades a plaintext connection (587); SSL wraps
# the whole one (465). Asking for both makes aiosmtplib raise.
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=Beff <no-reply@beff.example>
EMAIL_VERIFICATION_TTL_SECONDS=86400
